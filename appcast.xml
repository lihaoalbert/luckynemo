<?xml version="1.0" standalone="yes"?>
<!--
  LuckyNemo Sparkle appcast (initial skeleton).

  This feed replaces the upstream OpenClaw appcast inherited by the fork.
  LuckyNemo release history starts with the first LuckyNemo release; no
  OpenClaw items are carried over.

  Channels: stable releases ship as plain <item>s; beta releases ship with
  <sparkle:channel>beta</sparkle:channel> (see scripts/make_appcast.sh).
  Feed URL: https://raw.githubusercontent.com/lihaoalbert/luckynemo/main/appcast.xml
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
    <channel>
        <title>LuckyNemo</title>
        <link>https://raw.githubusercontent.com/lihaoalbert/luckynemo/main/appcast.xml</link>
        <description>LuckyNemo release feed (Sparkle). History starts with the first LuckyNemo release.</description>
        <language>en</language>
    </channel>
</rss>
